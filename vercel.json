{
  "version": 2,
  "functions": {
    "api/server.js": {
      "maxDuration": 60,
      "excludeFiles": "node_modules/ffmpeg-static/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/server.js"
    },
    {
      "source": "/proxy/:path*",
      "destination": "/api/server.js"
    },
    {
      "source": "/fetch",
      "destination": "/api/server.js"
    }
  ]
}
