{
  "version": 2,
  "functions": {
    "api/**/*.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/server.js"
    },
    {
      "source": "/proxy/:path*",
      "destination": "/api/server.js"
    },
    {
      "source": "/fetch",
      "destination": "/api/server.js"
    },
    {
      "source": "/(.*)",
      "destination": "/$1"
    }
  ]
}
